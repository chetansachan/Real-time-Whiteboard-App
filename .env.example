# Frontend env. All variables are exposed to the browser as
# VITE_*; do NOT put secrets here.

# Base URL of the backend API. Leave empty to use the Vite proxy (/api
# and /ws), which is the default for local dev.
VITE_API_BASE_URL=

# Default request timeout (ms) for REST calls to the backend.
VITE_API_TIMEOUT_MS=15000

# Max number of retry attempts for idempotent requests on transient
# failures (network error or 5xx).
VITE_API_MAX_RETRIES=2

# WebSocket reconnect tuning (ms).
VITE_WS_RECONNECT_MIN_MS=1000
VITE_WS_RECONNECT_MAX_MS=15000

# When true the websocket pauses while the tab is hidden.
VITE_WS_PAUSE_ON_HIDDEN=true
