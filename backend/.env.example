# --- HTTP server --------------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s
REQUEST_TIMEOUT=30s

# --- Database -----------------------------------------------------------
# PostgreSQL connection string. Example for local Docker:
#   postgres://whiteboard:whiteboard@localhost:5432/whiteboard?sslmode=disable
DATABASE_URL=

# --- WebSocket ----------------------------------------------------------
WS_READ_LIMIT=1048576
WS_WRITE_WAIT=10s
WS_PING_PERIOD=30s

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed origins. Use "*" to allow any origin
# (then credentials are not sent).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Logging ------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
